#!/usr/bin/env bash
# npm CLI wrapper for cc-statusline.

set -uo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  case "$SOURCE" in /*) ;; *) SOURCE="$DIR/$SOURCE" ;; esac
done

BIN_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
PACKAGE_DIR="$(cd -P "$BIN_DIR/.." && pwd)"
STATUSLINE="$PACKAGE_DIR/statusline.sh"
VERSION_FILE="$PACKAGE_DIR/VERSION"

err() {
  printf 'cc-statusline: %s\n' "$*" >&2
}

usage() {
  cat <<'EOF'
Usage: cc-statusline <command> [options]

Commands:
  render      read Claude Code session JSON from stdin and render the statusline
  install     run the installer from this package
  configure   alias for install
  version     show the packaged version
  help        show this help

With no command and piped stdin, cc-statusline renders the statusline.
EOF
}

render() {
  exec "$STATUSLINE"
}

cmd="${1:-}"
case "$cmd" in
  "")
    if [ -t 0 ]; then
      usage
      exit 0
    fi
    render
    ;;
  render)
    shift
    render "$@"
    ;;
  install|configure)
    shift
    exec "$PACKAGE_DIR/install.sh" "$@"
    ;;
  version)
    if [ -f "$VERSION_FILE" ]; then
      cat "$VERSION_FILE"
    else
      printf 'unknown\n'
    fi
    ;;
  help|--help|-h)
    usage
    ;;
  *)
    err "unknown command: $cmd"
    err "run 'cc-statusline help' for usage"
    exit 1
    ;;
esac
