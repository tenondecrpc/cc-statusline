{
  "preset": "default",
  "separator": " │ ",
  "lines": [
    ["basic_statusline"]
  ],
  "modules": {
    "model": { "with_version": true, "with_effort": true },
    "directory": { "tilde": true, "truncate": 30 },
    "git": { "show_status": true, "show_ahead_behind": true },
    "context_bar": { "label": "ctx", "width": 10, "thresholds_pct": [70, 90] },
    "rate_limit": { "bar_width": 10, "thresholds_pct": [60, 80] },
    "cost": { "format": "$%.2f", "hide_below": 0.01 }
  },
  "colors": {
    "model": "white",
    "effort": "gray",
    "directory": "blue",
    "git_clean": "green",
    "git_dirty": "yellow",
    "context_ok": "bright_green",
    "context_warn": "yellow",
    "context_crit": "red",
    "rate_ok": "bright_green",
    "rate_warn": "yellow",
    "rate_crit": "red",
    "rate_reset": "gray",
    "cost": "magenta",
    "session_timer": "gray",
    "lines_changed": "gray",
    "vim_mode": "magenta",
    "worktree": "blue",
    "agent": "magenta"
  }
}
